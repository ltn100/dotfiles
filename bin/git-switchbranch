#!/bin/bash

usage() {
    echo "usage: git switchbranch"
}

version() {
    echo "switchbranch v0.0.2"
}


get_branch_fzf() {
    selected=$(\
        git for-each-ref --format='%(refname:short)' --sort=-committerdate refs/heads/ | \
        fzf --preview 'git diff --color=always $(git merge-base origin/main {})..{}' \
    )
    if [ "$selected" == "" ]; then
        exit 1
    fi
    echo "$selected"
}

get_branch_bash() {
    # Set the prompt string
    PS3="--> Select a branch? "
    # first branch is always "master"
    branches=("develop master $(git branch --sort=-committerdate | sed -e 's/*//' -e 's/(no branch)//' -e 's/^[[:space:]]*master//' -e 's/^[[:space:]]*develop//' | head -n 10)")
    select selected in $branches; do
        if [ "$selected" == "quit" -o "$selected" == "q" -o "$selected" == "" ]; then
            exit 1
        fi
        echo "$selected"
        exit 0
    done
}

select_branch() {
    if command -v fzf &> /dev/null
    then
        branch=$(get_branch_fzf "$@")
    else
        branch=$(get_branch_bash "$@")
    fi

    git checkout "$branch"
}

main() {
    command="$1"
    shift
    case $command in
        "version") version;;
        *) select_branch "$@";;
    esac
}

main "$@"
