# solid block cursor
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

# typography
font-family = Hack Nerd Font Mono
font-size = 14
font-thicken=true
font-thicken-strength=1
adjust-cell-height=1

mouse-hide-while-typing = true

term = xterm-256color

right-click-action = copy-or-paste

# tabs in title bar
# gtk-titlebar-style=tabs

# Generated by Spectre v0.2.0 - Ghostty Config Generator
# https://github.com/imrajyavardhan12/spectre-ghostty-config
# Theme: Builtin Tango Dark

# Colors
background = #000000
foreground = #cccccc
cursor-color = #ffffff
cursor-text = #000000
selection-background = #b5d5ff
selection-foreground = #000000
palette = 0=#000000
palette = 1=#cc0000
palette = 2=#4e9a06
palette = 3=#c4a000
palette = 4=#3465a4
palette = 5=#75507b
palette = 6=#06989a
palette = 7=#d3d7cf
palette = 8=#555753
palette = 9=#ef2929
palette = 10=#8ae234
palette = 11=#fce94f
palette = 12=#729fcf
palette = 13=#ad7fa8
palette = 14=#34e2e2
palette = 15=#eeeeec

